// Daily Log routes
app.get('/api/daily-log/list', async (req: Request, res: Response) => {
  try {
    const logs = await db.select().from(dailyLogs).orderBy(dailyLogs.date.desc());
    res.json(logs);
  } catch (error) {
    res.status(500).json({ error: 'Failed to fetch daily logs' });
  }
});

app.get('/api/daily-log/:date', async (req: Request, res: Response) => {
  try {
    const date = req.params.date;
    // Validate date format (YYYY-MM-DD)
    if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) {
      return res.status(400).json({ error: 'Invalid date format. Use YYYY-MM-DD' });
    }
    
    const [log] = await db.select().from(dailyLogs).where(eq(dailyLogs.date, date));
    if (!log) {
      return res.status(404).json({ error: 'Daily log not found for this date' });
    }
    
    const entries = await db.select().from(dailyEntries)
      .where(eq(dailyEntries.logId, log.id))
      .orderBy(dailyEntries.createdAt.desc());
    
    res.json({
      ...log,
      entries
    });
  } catch (error) {
    res.status(500).json({ error: 'Failed to fetch daily log' });
  }
});

app.post('/api/daily-log/:date/entries', async (req: Request, res: Response) => {
  try {
    const date = req.params.date;
    // Validate date format (YYYY-MM-DD)
    if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) {
      return res.status(400).json({ error: 'Invalid date format. Use YYYY-MM-DD' });
    }
    
    const [log] = await db.select().from(dailyLogs).where(eq(dailyLogs.date, date));
    
    if (!log) {
      // Create log if it doesn't exist
      const [newLog] = await db.insert(dailyLogs).values({
        date,
        summary: req.body.summary || ''
      }).returning();
      
      const [newEntry] = await db.insert(dailyEntries).values({
        logId: newLog.id,
        text: req.body.text,
        isHighlight: req.body.isHighlight || false,
        taskId: req.body.taskId || null
      }).returning();
      
      return res.status(201).json(newEntry);
    }
    
    const [newEntry] = await db.insert(dailyEntries).values({
      logId: log.id,
      text: req.body.text,
      isHighlight: req.body.isHighlight || false,
      taskId: req.body.taskId || null
    }).returning();
    
    res.status(201).json(newEntry);
  } catch (error) {
    res.status(500).json({ error: 'Failed to create daily log entry' });
  }
});

app.patch('/api/daily-log/entries/:id', async (req: Request, res: Response) => {
  try {
    const entryId = parseInt(req.params.id);
    if (isNaN(entryId)) {
      return res.status(400).json({ error: 'Invalid entry ID' });
    }
    
    const { text, isHighlight, taskId } = req.body;
    
    const [updatedEntry] = await db.update(dailyEntries)
      .set({
        text: text !== undefined ? text : undefined,
        isHighlight: isHighlight !== undefined ? isHighlight : undefined,
        taskId: taskId !== undefined ? taskId : undefined
      })
      .where(eq(dailyEntries.id, entryId))
      .returning();
    
    if (!updatedEntry) {
      return res.status(404).json({ error: 'Entry not found' });
    }
    
    res.json(updatedEntry);
  } catch (error) {
    res.status(500).json({ error: 'Failed to update daily log entry' });
  }
});

