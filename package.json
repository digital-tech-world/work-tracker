{
  "name": "work-tracker",
  "version": "1.0.0",
  "description": "A fully local, single-user web app for tracking tasks, bookmarks, notes, and daily work logs",
  "private": true,
  "workspaces": [
    "tool/shared",
    "tool/server",
    "tool/client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch tool/server/index.ts",
    "dev:client": "vite --config tool/client/vite.config.ts",
    "build": "tsc -p tool/server/tsconfig.json && vite build --config tool/client/vite.config.ts",
    "db:push": "drizzle-kit push --config tool/server/drizzle.config.ts",
    "db:seed": "tsx tool/server/db/seed.ts",
    "start": "node tool/server/dist/index.js"
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "drizzle-kit": "^0.31.10",
    "pg": "^8.23.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "js-sha256": "^1.0.0",
    "ollama": "^0.6.3"
  }
}
